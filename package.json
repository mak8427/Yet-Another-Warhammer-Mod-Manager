{
  "name": "wh3mm-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @wh3mm/desktop dev",
    "build": "pnpm --filter @wh3mm/desktop build",
    "typecheck": "pnpm --filter @wh3mm/desktop typecheck",
    "lint": "pnpm --filter @wh3mm/desktop lint",
    "test": "pnpm --filter @wh3mm/desktop test",
    "reference": "bash scripts/dev/fetch-reference.sh",
    "test:reference": "bash scripts/dev/fetch-reference.test.sh",
    "fixtures:verify": "bash scripts/dev/verify-fixtures.sh",
    "fixtures:write": "node scripts/qa/generate-fixtures.mjs --write",
    "fixtures:perf": "node scripts/perf/generate-suite.mjs",
    "bench": "bash scripts/perf/bench.sh",
    "bench:budget": "node scripts/perf/scan-budget.mjs",
    "qa:scripts": "node --test scripts/qa/*.test.mjs && python3 scripts/qa/install-recipes.test.py",
    "perf:gate": "node scripts/qa/verify-perf-gate.mjs",
    "docs:check": "node scripts/qa/check-docs.mjs"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
