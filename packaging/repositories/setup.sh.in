#!/usr/bin/env bash
# Download and inspect this script before running it. No packages are installed.
set -euo pipefail
if [[ ${1:-} == --help ]]; then
  echo 'Configure the signed WH3 Mod Manager apt, dnf, zypper, or pacman repository.'
  echo 'Usage: bash setup.sh (needs curl, gpg, and sudo/root; x86_64 Linux only)'
  exit 0
fi
base='@BASE_URL@'
expected='@FINGERPRINT@'
[[ $base == https://* && $expected =~ ^[A-F0-9]{40}$ ]] || {
  echo 'This is a template; use the setup.sh generated by the repository publisher.' >&2; exit 1;
}
[[ $(uname -m) == x86_64 ]] || { echo 'Only x86_64 is supported.' >&2; exit 1; }
command -v curl >/dev/null
command -v gpg >/dev/null
# Provided by the host distribution, not a repository input.
# shellcheck disable=SC1091
source /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
  *' debian '*|*' ubuntu '*) manager=apt ;;
  *' fedora '*) manager=dnf ;;
  *' opensuse '*|*' opensuse-tumbleweed '*|*' suse '*) manager=zypper ;;
  *' arch '*|*' manjaro '*) manager=pacman ;;
  *) echo "Unsupported distribution: ${ID:-unknown}; use Flatpak or a release download." >&2; exit 1 ;;
esac
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -m700 "$work/gnupg"
curl --fail --silent --show-error --location "$base/repository-key.asc" -o "$work/key.asc"
actual=$(gpg --homedir "$work/gnupg" --batch --show-keys --with-colons "$work/key.asc" | awk -F: '$1=="pub" {pubs++} $1=="fpr" && !fpr {fpr=$10} END {if(pubs==1) print fpr}')
[[ $actual == "$expected" ]] || { echo 'Signing key fingerprint mismatch; no system changes made.' >&2; exit 1; }
root=()
if [[ $(id -u) != 0 ]]; then root=(sudo); fi
case "$manager" in
  apt)
    gpg --homedir "$work/gnupg" --batch --dearmor --output "$work/wh3mm.gpg" "$work/key.asc"
    "${root[@]}" install -Dm644 "$work/wh3mm.gpg" /usr/share/keyrings/wh3mm.gpg
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/wh3mm.gpg] $base/apt stable main" > "$work/wh3mm.list"
    "${root[@]}" install -Dm644 "$work/wh3mm.list" /etc/apt/sources.list.d/wh3mm.list
    echo 'Repository configured. Run: sudo apt update && sudo apt install wh3-mod-manager'
    ;;
  dnf|zypper)
    "${root[@]}" rpm --import "$work/key.asc"
    cat > "$work/wh3mm.repo" <<REPO
[wh3mm]
name=WH3 Mod Manager
baseurl=$base/rpm
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=$base/repository-key.asc
REPO
    if [[ $manager == dnf ]]; then
      "${root[@]}" install -Dm644 "$work/wh3mm.repo" /etc/yum.repos.d/wh3mm.repo
      echo 'Repository configured. Run: sudo dnf install wh3-mod-manager'
    else
      "${root[@]}" install -Dm644 "$work/wh3mm.repo" /etc/zypp/repos.d/wh3mm.repo
      echo 'Repository configured. Run: sudo zypper refresh && sudo zypper install wh3-mod-manager'
    fi
    ;;
  pacman)
    "${root[@]}" pacman-key --add "$work/key.asc"
    "${root[@]}" pacman-key --lsign-key "$expected"
    cat > "$work/wh3mm.conf" <<REPO
[wh3mm]
SigLevel = Required DatabaseRequired
Server = $base/arch/\$arch
REPO
    "${root[@]}" install -Dm644 "$work/wh3mm.conf" /etc/pacman.d/wh3mm.conf
    if ! grep -Eq '^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman.d/wh3mm.conf[[:space:]]*$' /etc/pacman.conf; then
      printf '\nInclude = /etc/pacman.d/wh3mm.conf\n' | "${root[@]}" tee -a /etc/pacman.conf >/dev/null
    fi
    echo 'Repository configured. Run: sudo pacman -Syu wh3mm-bin'
    ;;
esac
