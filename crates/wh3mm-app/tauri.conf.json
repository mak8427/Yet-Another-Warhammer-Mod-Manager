{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WH3 Mod Manager",
  "version": "0.1.0",
  "identifier": "com.warhammerlabs.wh3mm",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../../frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WH3 Mod Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
